# Copy to .env and adjust values. Scripts read the shell environment only — they do
# not load this file automatically. From CloudRun/ (or before running scripts):
#   set -a && source .env && set +a
# Or: export PROJECT_ID=... etc.

# --- GCP / Artifact Registry (setup_gcp, build_push, deploy, destroy) ---
PROJECT_ID=cloud-run-lab-demo
REGION=us-central1
AR_REPO=cloud-run-lab

# --- Image & Cloud Run service name ---
IMAGE_NAME=iris-svm-api
IMAGE_TAG=v1

# Derived URI (for reference; scripts compute this from the variables above):
# ${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/${IMAGE_NAME}:${IMAGE_TAG}

# --- test_api.sh: deployed service URL (or pass as first argument) ---
# BASE_URL=https://iris-svm-api-xxxxx-uc.a.run.app

# --- destroy_cloud_run.sh only (optional; unset or 0 = default behavior) ---
# SKIP_PROMPT=1
# DELETE_AR_IMAGE=1
# DELETE_LOCAL_IMAGE=1
